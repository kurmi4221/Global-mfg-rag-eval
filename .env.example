# Copy to .env and fill in. Never commit .env.
# Only needed for the optional LLM-as-judge and LangSmith tracing paths.
# The gate demo and the test-suite run with NO keys.

OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mfg-rag-eval
GROK_API_KEY=
XAI_API_KEY=
# Self-hosted LangSmith (one instance per geo): set your regional endpoint.
# LANGSMITH_ENDPOINT=https://langsmith.eu.example.internal

# Local judge for restricted / air-gapped cells (Ollama default port)
# OLLAMA_BASE_URL=http://localhost:11434
